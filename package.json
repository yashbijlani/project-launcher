{
  "name": "project-launcher",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Universal local project launcher: deterministic discovery, supervised multi-service start/stop.",
  "license": "MIT",
  "author": "Yash Bijlani <yashbijlani2004@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yashbijlani/project-launcher.git"
  },
  "homepage": "https://github.com/yashbijlani/project-launcher",
  "bin": {
    "launcher": "./bin/launcher.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "node --test test/*.test.js",
    "scan": "node bin/launcher.js scan",
    "launcher": "node bin/launcher.js"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
